generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  email       String?
  phone       String?
  contactName String?           // Nombre del responsable
  city        String?
  state       String?
  website     String?
  plan        String   @default("STARTER")  // STARTER | PRO | ENTERPRISE
  status      String   @default("ACTIVE")   // PENDING | ACTIVE | SUSPENDED
  active      Boolean  @default(true)
  notes       String?           // Notas internas del super admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  shipments Shipment[]
  clients   Client[]
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String
  pin       String   @unique  // PIN numérico para identificar la bodega al escanear
  active    Boolean  @default(true)
  notes     String?           // Notas internas (solo admin)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    TrackingEvent[]
}

model User {
  id             String   @id @default(cuid())
  supabaseId     String?  @unique
  email          String   @unique
  name           String
  role           String   @default("AGENCY")
  status         String   @default("ACTIVE")   // PENDING | ACTIVE | INACTIVE
  active         Boolean  @default(true)
  whatsappPhone  String?  @unique              // Número vinculado al agente WA
  inviteToken    String?  @unique              // Token de invitación pendiente
  inviteExpiry   DateTime?                     // Expiración del token
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agencyId   String?
  agency     Agency?  @relation(fields: [agencyId], references: [id])

  createdShipments  Shipment[]      @relation("CreatedBy")
  assignedShipments Shipment[]      @relation("AssignedDriver")
  trackingEvents    TrackingEvent[] @relation("CreatedBy")
  driverLocation    DriverLocation?
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String   @unique
  lat       Float
  lng       Float
  heading   Float?
  active    Boolean  @default(true)   // true = en ruta
  updatedAt DateTime @updatedAt

  driver    User     @relation(fields: [driverId], references: [id])
}

model Address {
  id         String  @id @default(cuid())
  street     String
  colonia    String?
  city       String
  state      String
  zip        String
  country    String  @default("MX")
  references String?
  lat        Float?
  lng        Float?

  originShipments      Shipment[] @relation("Origin")
  destinationShipments Shipment[] @relation("Destination")
}

model Shipment {
  id          String   @id @default(cuid())
  guideNumber String   @unique
  status      String   @default("RECEIVED")

  senderName    String
  senderPhone   String?
  senderEmail   String?

  recipientName  String
  recipientPhone String?
  recipientEmail String?

  weight        Float?
  packageType   String  @default("PACKAGE")
  description   String?
  pieces        Int     @default(1)
  declaredValue Float?

  serviceType      String   @default("STANDARD")
  notes            String?
  notifyRecipient  Boolean  @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  estimatedAt DateTime?
  deliveredAt DateTime?

  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])

  createdById String?
  createdBy   User?    @relation("CreatedBy", fields: [createdById], references: [id])

  assignedDriverId String?
  assignedDriver   User?   @relation("AssignedDriver", fields: [assignedDriverId], references: [id])

  originId      String?
  origin        Address? @relation("Origin", fields: [originId], references: [id])

  destinationId String?
  destination   Address? @relation("Destination", fields: [destinationId], references: [id])

  events TrackingEvent[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  street    String?
  city      String?
  state     String?
  zip       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
}

model WhatsappSession {
  id        String   @id @default(cuid())
  phone     String   @unique
  messages  Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model TrackingEvent {
  id          String   @id @default(cuid())
  status      String
  description String
  location    String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?      @relation("CreatedBy", fields: [createdById], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
}
